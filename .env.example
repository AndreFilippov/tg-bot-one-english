# Токен от @BotFather
BOT_TOKEN=
# Ключ из https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модель Gemini (см. https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.8-flash
# Ваш Telegram ID (узнать: бот @userinfobot). Остальных бот игнорирует
ALLOWED_USER_ID=
# Необязательно: голос озвучки по умолчанию
TTS_VOICE=en-US-AriaNeural
# Уровень «размышлений» Gemini: low/medium/high; пусто — не передавать параметр
GEMINI_THINKING=low
# Ваш часовой пояс для напоминаний (список: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=Europe/Moscow
# Запасные модели через запятую (лимит на бесплатном тарифе считается отдельно по каждой модели)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash
# Проверка доступа по ALLOWED_USER_ID (on/off)
ACCESS_CHECK=on