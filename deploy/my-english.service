[Unit]
Description=My English Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=english
WorkingDirectory=/home/english/my-english
ExecStart=/home/english/my-english/.venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
